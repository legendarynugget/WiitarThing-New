<Window x:Class="WiitarThing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:WiitarThing"
        Title="WiitarThing" Height="520" Width="720" MinWidth="680" MinHeight="500"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        Background="{DynamicResource BrushBgDark}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ShowWindowCommand x:Key="ShowWindow"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tray Icon with Double-Click Support -->
        <tb:TaskbarIcon x:Name="trayIcon" 
                        IconSource="/WiitarThing;component/GHWT_Wii_Guitar.ico"
                        ToolTipText="WiitarThing" 
                        Visibility="Hidden"
                        DoubleClickCommand="{StaticResource ShowWindow}"
                        TrayMouseDoubleClick="trayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="MenuItem_Show_Click" FontWeight="Bold"/>
                    <MenuItem Header="Refresh" Click="MenuItem_Refresh_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuItem_Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Header / Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button x:Name="btnSync" Content="⚡ SYNC NEW CONTROLLER" Background="{DynamicResource ButtonSuccessBrush}" Height="34" Padding="14,0" Click="btnSync_Click" ToolTip="Pair and sync new Wii Remotes / Guitars"/>
                <Button x:Name="btnRefresh" Content="🔄 Refresh List" Background="#374151" Height="34" Margin="8,0,0,0" Padding="10,0" Click="btnRefresh_Click" ToolTip="Scan for newly attached Bluetooth/USB devices"/>
                <Button x:Name="btnRemoveAllWiimotes" Content="❌ Unpair All Wiimotes" Background="#4B1E22" BorderBrush="#EF4444" BorderThickness="1" Height="34" Margin="8,0,0,0" Padding="10,0" Click="btnRemoveAllWiimotes_Click" ToolTip="Unpair/remove all Nintendo controllers from Windows Bluetooth registry"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Button x:Name="btnTest" Content="🎮 Test Gamepads" Background="#374151" Height="34" Padding="10,0" Click="buttonTestInputs_Click" ToolTip="Open Windows Game Controllers (joy.cpl)"/>
                <Button x:Name="btnSettings" Content="⚙ Settings" Background="#374151" Height="34" Margin="8,0,0,0" Padding="10,0" Click="btnSettings_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="menu_AutoStart" Header="Start with Windows" Click="menu_AutoStart_Click"/>
                            <MenuItem x:Name="menu_StartMinimized" Header="Start Minimized to Tray" Click="menu_StartMinimized_Click"/>
                            <MenuItem x:Name="menu_AutoRefresh" Header="Automatic Device Detection" Click="menu_AutoRefresh_Click"/>
                            <Separator/>
                            <!-- Notification Controls -->
                            <MenuItem Header="Notifications">
                                <MenuItem x:Name="menu_NotifyAll" Header="Enable All Notifications" Click="menu_NotifyAll_Click"/>
                                <MenuItem x:Name="menu_NotifyBattery" Header="Low Battery Warnings" Click="menu_NotifyBattery_Click"/>
                                <MenuItem x:Name="menu_NotifyDisconnect" Header="Controller Disconnected Alerts" Click="menu_NotifyDisconnect_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="menu_Repo" Header="Visit GitHub Repository" Click="menu_Github_Click"/>
                            <MenuItem x:Name="menu_version" Header="Version" IsEnabled="False"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Device List Panes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Devices -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgMedium}" CornerRadius="8" Margin="0,0,6,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="AVAILABLE DEVICES" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="groupAvailable"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Connected Devices (XInput) -->
            <Border Grid.Column="1" Background="{DynamicResource BrushBgMedium}" CornerRadius="8" Margin="6,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONNECTED AS XBOX 360 CONTROLLERS" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="groupXinput"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Disconnect All & Credits -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="WiitarThing • Low Latency Wii Controller Bridge for PC" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnDetatchAll" Content="Disconnect All Devices" Background="{DynamicResource ButtonDangerBrush}" Height="28" Padding="12,0" Click="btnDetatchAllXInput_Click"/>
        </Grid>
    </Grid>
</Window>