<Window x:Class="WiitarThing.Windows.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pairing Controller" Height="340" Width="520" MinWidth="480" MinHeight="300"
        Background="{DynamicResource BrushBgDark}" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Pairing Mode Active" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Press the RED SYNC button inside the battery door (or press 1 + 2)." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Log Output -->
        <RichTextBox x:Name="promptBoxContainer" Grid.Row="1" Background="{DynamicResource BrushBgMedium}" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <FlowDocument x:Name="prompt" PagePadding="6"/>
        </RichTextBox>

        <!-- Footer / Cancel -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar x:Name="scanProgress" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,110,0"/>
            <Button x:Name="cancelBtn" Content="Done / Close" Background="#374151" HorizontalAlignment="Right" Width="100" Height="30" Click="cancelBtn_Click"/>
        </Grid>
    </Grid>
</Window>