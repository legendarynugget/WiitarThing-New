<UserControl x:Class="WiitarThing.DeviceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="330" d:DesignHeight="84" Height="84" Margin="0,0,0,8" HorizontalAlignment="Stretch">
    <Border x:Name="cardBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#4E5058" Background="#252538">
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Controller Image -->
            <Image x:Name="icon" Grid.Column="0" Source="{DynamicResource UIcon}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Name, Status, and Battery -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                <Label x:Name="labelName" Content="Wii Controller" FontWeight="Bold" FontSize="13" Foreground="White" Padding="0" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="statusIndicator" Width="7" Height="7" Fill="#9CA3AF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="statusText" Text="Ready to connect" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" TextWrapping="NoWrap"/>

                    <!-- Live Battery Display -->
                    <StackPanel x:Name="batteryPanel" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- Battery Icon Glyph -->
                        <Path x:Name="batteryIcon" Data="M16 4h-1V2.5C15 1.7 14.3 1 13.5 1h-7C5.7 1 5 1.7 5 2.5V4H4C2.3 4 1 5.3 1 7v13c0 1.7 1.3 3 3 3h12c1.7 0 3-1.3 3-3V7c0-1.7-1.3-3-3-3z" 
                              Fill="#10B981" Stretch="Uniform" Width="8" Height="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="batteryText" Text="100%" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Actions Panel -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Identify Button (Magnifying Glass with "ID" inside) -->
                <Button x:Name="btnIdentify" Width="30" Height="30" Margin="0,0,4,0" ToolTip="Identify (Vibrate / Flash LEDs)" Background="#374151" Click="btnIdentify_Click">
                    <Grid Width="16" Height="16">
                        <Path Data="M6.5 0C2.91 0 0 2.91 0 6.5S2.91 13 6.5 13c1.61 0 3.09-.59 4.23-1.57l4.14 4.14c.39.39 1.02.39 1.41 0s.39-1.02 0-1.41l-4.14-4.14C12.41 9.59 13 8.11 13 6.5 13 2.91 10.09 0 6.5 0zm0 2C8.99 2 11 4.01 11 6.5S8.99 11 6.5 11 2 8.99 2 6.5 4.01 2 6.5 2z" 
                              Fill="#E5E7EB" Stretch="Uniform"/>
                        <TextBlock Text="ID" FontWeight="Black" FontSize="6.5" Foreground="#E5E7EB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5,2.5,0,0"/>
                    </Grid>
                </Button>

                <!-- Properties Button (Gear Icon) -->
                <Button x:Name="btnProperties" Width="30" Height="30" Margin="0,0,6,0" ToolTip="Settings &amp; Properties" Background="#374151" Click="btnProperties_Click">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                          Fill="#E5E7EB" Stretch="Uniform" Width="14" Height="14"/>
                </Button>

                <!-- Connect Button -->
                <Button x:Name="btnXinput" Content="CONNECT" Width="68" Height="30" Background="{DynamicResource ButtonSuccessBrush}" FontWeight="Bold" FontSize="11" Click="btnXinput_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="XOption1" Header="Connect as Player 1" Click="XOption_Click"/>
                            <MenuItem x:Name="XOption2" Header="Connect as Player 2" Click="XOption_Click"/>
                            <MenuItem x:Name="XOption3" Header="Connect as Player 3" Click="XOption_Click"/>
                            <MenuItem x:Name="XOption4" Header="Connect as Player 4" Click="XOption_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Disconnect Button -->
                <Button x:Name="btnDetatch" Content="DISCONNECT" Width="78" Height="30" Background="{DynamicResource ButtonDangerBrush}" FontWeight="Bold" FontSize="10" Click="btnDetatch_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>